<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="005-create-vehicle-movements" author="chatgpt">
        <comment>Створення журналу операцій з транспортом</comment>

        <createTable tableName="vehicle_movements">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="vehicle_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="driver_id" type="BIGINT"/>

            <column name="type" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>

            <column name="previous_status" type="VARCHAR(20)"/>

            <column name="new_status" type="VARCHAR(20)"/>

            <column name="notes" type="VARCHAR(500)"/>

            <column name="performed_by" type="VARCHAR(100)"/>

            <column name="performed_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="vehicle_movements"
                baseColumnNames="vehicle_id"
                referencedTableName="vehicles"
                referencedColumnNames="id"
                constraintName="fk_vehicle_movement_vehicle"
                onDelete="RESTRICT"/>

        <addForeignKeyConstraint
                baseTableName="vehicle_movements"
                baseColumnNames="driver_id"
                referencedTableName="drivers"
                referencedColumnNames="id"
                constraintName="fk_vehicle_movement_driver"
                onDelete="SET NULL"/>

        <createIndex indexName="idx_movement_vehicle" tableName="vehicle_movements">
            <column name="vehicle_id"/>
        </createIndex>

        <createIndex indexName="idx_movement_type" tableName="vehicle_movements">
            <column name="type"/>
        </createIndex>

        <createIndex indexName="idx_movement_performed_at" tableName="vehicle_movements">
            <column name="performed_at" descending="true"/>
        </createIndex>

        <rollback>
            <dropTable tableName="vehicle_movements"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
