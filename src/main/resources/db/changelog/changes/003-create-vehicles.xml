<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="003-create-vehicles" author="gpt-5.1-codex-max">
        <comment>Створення таблиці транспортних засобів</comment>

        <createTable tableName="vehicles">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="model" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="registration_number" type="VARCHAR(20)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="category_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="engine_number" type="VARCHAR(50)" unique="true"/>
            <column name="chassis_number" type="VARCHAR(50)" unique="true"/>
            <column name="manufacture_year" type="INTEGER"/>
            <column name="mileage" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="fuel_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="fuel_consumption" type="DOUBLE PRECISION"/>
            <column name="maintenance_interval_km" type="INTEGER"/>
            <column name="last_maintenance_date" type="DATE"/>
            <column name="next_maintenance_date" type="DATE"/>
            <column name="last_maintenance_mileage" type="INTEGER"/>
            <column name="driver_id" type="BIGINT"/>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
            constraintName="fk_vehicles_category"
            baseTableName="vehicles"
            baseColumnNames="category_id"
            referencedTableName="vehicle_categories"
            referencedColumnNames="id"
            onDelete="RESTRICT"/>

        <addForeignKeyConstraint
            constraintName="fk_vehicles_driver"
            baseTableName="vehicles"
            baseColumnNames="driver_id"
            referencedTableName="drivers"
            referencedColumnNames="id"
            onDelete="SET NULL"/>

        <rollback>
            <dropForeignKeyConstraint constraintName="fk_vehicles_driver" baseTableName="vehicles"/>
            <dropForeignKeyConstraint constraintName="fk_vehicles_category" baseTableName="vehicles"/>
            <dropTable tableName="vehicles"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
